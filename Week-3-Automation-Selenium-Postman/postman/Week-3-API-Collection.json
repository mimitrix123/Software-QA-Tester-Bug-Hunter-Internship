{
  "info": {
    "name": "Week 3 API Testing - JSONPlaceholder",
    "_postman_id": "week3-jsonplaceholder-qa",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{"key":"baseUrl","value":"https://jsonplaceholder.typicode.com"}],
  "item": [
    {"name":"API-01 GET Posts","request":{"method":"GET","header":[],"url":"{{baseUrl}}/posts"},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));","pm.test('Response has posts', () => pm.expect(pm.response.json().length).to.be.above(0));"]}}]},
    {"name":"API-02 GET Post by ID","request":{"method":"GET","header":[],"url":"{{baseUrl}}/posts/1"},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('ID is 1', () => pm.expect(pm.response.json().id).to.eql(1));"]}}]},
    {"name":"API-03 POST Post","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"title\": \"QA automation\",\n  \"body\": \"Week 3 API test\",\n  \"userId\": 1\n}"},"url":"{{baseUrl}}/posts"},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 201', () => pm.response.to.have.status(201));","const data = pm.response.json();","pm.test('Title is returned', () => pm.expect(data.title).to.eql('QA automation'));","pm.test('Created ID exists', () => pm.expect(data.id).to.exist);"]}}]},
    {"name":"API-04 PUT Post","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"id\": 1,\n  \"title\": \"Updated by QA\",\n  \"body\": \"Updated API test\",\n  \"userId\": 1\n}"},"url":"{{baseUrl}}/posts/1"},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Updated title returned', () => pm.expect(pm.response.json().title).to.eql('Updated by QA'));","pm.test('ID is 1', () => pm.expect(pm.response.json().id).to.eql(1));"]}}]},
    {"name":"API-05 DELETE Post","request":{"method":"DELETE","header":[],"url":"{{baseUrl}}/posts/1"},"event":[{"listen":"test","script":{"exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));"]}}]}
  ]
}